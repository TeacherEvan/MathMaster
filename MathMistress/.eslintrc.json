{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-plusplus": "off",
    "no-use-before-define": ["error", { "functions": false, "classes": false }],
    "import/extensions": ["error", "ignorePackages", { "js": "always" }],
    "import/prefer-default-export": "off"
  }
}
